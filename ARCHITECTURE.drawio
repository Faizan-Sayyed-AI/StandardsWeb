<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram id="ists-architecture" name="StandardSphere System Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════════════════════════════════════════════════════════
             TITLE
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="title" value="StandardSphere | System Architecture"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="450" y="15" width="820" height="50" as="geometry" />
        </mxCell>

        <mxCell id="subtitle" value="Deployment: AWS EC2 · Docker Compose · PostgreSQL · Redis · Celery · Nginx"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="450" y="55" width="820" height="25" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             ZONE LABELS (decorative section separators)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="zone_client" value="CLIENT"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#666666;rotation=-90;"
          vertex="1" parent="1">
          <mxGeometry x="5" y="410" width="60" height="20" as="geometry" />
        </mxCell>

        <mxCell id="zone_external" value="EXTERNAL SERVICES"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#666666;rotation=-90;"
          vertex="1" parent="1">
          <mxGeometry x="1860" y="480" width="110" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             BOUNDARY — AWS EC2 INSTANCE
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="ec2" value="AWS EC2 Instance — Amazon Linux 2023 / Ubuntu 22.04 LTS (t3.large / t3.xlarge)"
          style="swimlane;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=left;spacingLeft=10;rounded=1;arcSize=3;"
          vertex="1" parent="1">
          <mxGeometry x="190" y="80" width="1400" height="960" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             NGINX  (inside EC2, outside Docker)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="nginx" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;Reverse Proxy + TLS&lt;br&gt;&lt;br&gt;:80 HTTP → :443 HTTPS&lt;br&gt;/api/* → FastAPI :8000&lt;br&gt;/* → React SPA (static)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="232" y="385" width="168" height="110" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             BOUNDARY — DOCKER NETWORK
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="docker" value="Docker Bridge Network — 6 Containers"
          style="swimlane;startSize=32;fillColor=#fffde7;strokeColor=#d6b656;fontStyle=1;fontSize=11;align=left;spacingLeft=10;rounded=1;arcSize=2;"
          vertex="1" parent="1">
          <mxGeometry x="455" y="115" width="1090" height="890" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             LAYER LABELS (inside Docker)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="lbl_presentation" value="PRESENTATION LAYER"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#999999;"
          vertex="1" parent="1">
          <mxGeometry x="470" y="155" width="160" height="16" as="geometry" />
        </mxCell>

        <mxCell id="lbl_task" value="TASK EXECUTION LAYER"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#999999;"
          vertex="1" parent="1">
          <mxGeometry x="1040" y="155" width="175" height="16" as="geometry" />
        </mxCell>

        <mxCell id="lbl_data" value="DATA LAYER"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#999999;"
          vertex="1" parent="1">
          <mxGeometry x="470" y="530" width="100" height="16" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             REACT 19 SPA  (static build, served by Nginx)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="frontend" value="&lt;b&gt;React 19 SPA&lt;/b&gt;&lt;br&gt;TypeScript 6 + Vite 8&lt;br&gt;TanStack Query v5&lt;br&gt;React Router v7&lt;br&gt;Tailwind CSS + Radix UI&lt;br&gt;&lt;i&gt;Built → /frontend/dist/&lt;/i&gt;&lt;br&gt;&lt;i&gt;Served as static files by Nginx&lt;/i&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="490" y="173" width="205" height="120" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             FASTAPI  (ists_web)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="fastapi" value="&lt;b&gt;ists_web&lt;/b&gt;&lt;br&gt;FastAPI + Python 3.12&lt;br&gt;Uvicorn (dev) / Gunicorn (prod)&lt;br&gt;Port :8000 · internal only&lt;br&gt;&lt;br&gt;APIs: auth, standards, feeds,&lt;br&gt;notifications, documents,&lt;br&gt;users, admin, dashboard&lt;br&gt;&lt;br&gt;Alembic migrations on startup"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="173" width="210" height="160" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             CELERY WORKER  (ists_worker)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="worker" value="&lt;b&gt;ists_worker&lt;/b&gt;&lt;br&gt;Celery Worker (solo pool)&lt;br&gt;Python 3.12&lt;br&gt;&lt;br&gt;Queues:&lt;br&gt;· feeds — RSS polling&lt;br&gt;· notifications — email + in-app&lt;br&gt;· maintenance — cleanup tasks"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1040" y="173" width="210" height="140" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             CELERY BEAT  (ists_beat)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="beat" value="&lt;b&gt;ists_beat&lt;/b&gt;&lt;br&gt;Celery Beat Scheduler&lt;br&gt;Python 3.12&lt;br&gt;&lt;br&gt;celery-sqlalchemy-scheduler&lt;br&gt;Reads schedule from PostgreSQL&lt;br&gt;(celery_periodic_task table)&lt;br&gt;Dispatches tasks to Redis broker"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1040" y="380" width="210" height="140" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             POSTGRESQL  (ists_db)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="postgres" value="&lt;b&gt;ists_db&lt;/b&gt;&lt;br&gt;PostgreSQL 16 Alpine&lt;br&gt;Port :5432 · internal only&lt;br&gt;Volume: ists_pgdata&lt;br&gt;&lt;br&gt;Tables: standards, users, rss_feeds,&lt;br&gt;standard_history, notifications,&lt;br&gt;documents, audit_logs,&lt;br&gt;distribution_lists, system_config,&lt;br&gt;celery_periodic_task (Beat schedule)"
          style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="490" y="550" width="210" height="155" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             REDIS  (ists_redis)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="redis" value="&lt;b&gt;ists_redis&lt;/b&gt;&lt;br&gt;Redis 7 Alpine&lt;br&gt;Port :6379 · internal only&lt;br&gt;Volume: ists_redisdata&lt;br&gt;&lt;br&gt;Celery Broker&lt;br&gt;Celery Result Backend&lt;br&gt;appendonly: yes"
          style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="550" width="210" height="155" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             DOCUMENT STORAGE  (local volume or S3)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="storage" value="&lt;b&gt;Document Storage&lt;/b&gt;&lt;br&gt;Volume: ists_document_storage&lt;br&gt;/app/storage/standards/&lt;br&gt;&lt;br&gt;Local (default): file system&lt;br&gt;OR switch to S3 via&lt;br&gt;STORAGE_BACKEND=s3 env var&lt;br&gt;&lt;br&gt;python-magic file validation"
          style="shape=dataStorage;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1040" y="550" width="210" height="155" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             DEV-ONLY NOTE  (inside Docker boundary)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="devonly" value="&lt;b&gt;Dev-only (not in production):&lt;/b&gt;&lt;br&gt;ists_mailhog — SMTP catch-all :1025 (SMTP) / :8025 (Web UI)&lt;br&gt;ists_frontend node:20-alpine Vite dev server :5173 → replaced by Nginx + npm run build"
          style="text;html=1;strokeColor=#d6b656;fillColor=#fffde7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;rounded=1;fontSize=10;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="490" y="770" width="640" height="55" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             ALEMBIC MIGRATIONS NOTE
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="migrations" value="&lt;b&gt;Alembic Migrations (0001→0006):&lt;/b&gt;&lt;br&gt;0001 Initial schema · 0002 content_hash · 0003 document_uploaded event&lt;br&gt;0004 system_config · 0005 stage + published_date · 0006 parent_standard_id"
          style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;rounded=1;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="490" y="850" width="760" height="55" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             USER / BROWSER  (outside EC2)
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="browser" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;Web Browser&lt;br&gt;(HTTPS :443)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;"
          vertex="1" parent="1">
          <mxGeometry x="25" y="415" width="115" height="75" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             EXTERNAL — rss2json.com
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="rss2json" value="&lt;b&gt;rss2json.com&lt;/b&gt;&lt;br&gt;RSS → JSON Proxy API&lt;br&gt;Auth: API key (env: RSS2JSON_API_KEY)&lt;br&gt;httpx / curl-cffi client"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1680" y="215" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             EXTERNAL — ISO.org
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="iso" value="&lt;b&gt;ISO.org&lt;/b&gt;&lt;br&gt;RSS Feed Source&lt;br&gt;(public internet)&lt;br&gt;feedparser 6.0"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1680" y="345" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             EXTERNAL — AWS S3
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="s3" value="&lt;b&gt;AWS S3&lt;/b&gt;&lt;br&gt;Bucket: ists-documents-prod&lt;br&gt;Optional storage backend&lt;br&gt;STORAGE_BACKEND=s3"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1680" y="495" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             EXTERNAL — SMTP RELAY
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="smtp" value="&lt;b&gt;SMTP Relay&lt;/b&gt;&lt;br&gt;AWS SES / SendGrid&lt;br&gt;aiosmtplib — STARTTLS :587&lt;br&gt;Email notifications to users"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="1680" y="635" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             LEGEND
        ═══════════════════════════════════════════════════════════════════ -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;── Internal network traffic&lt;br&gt;╌╌ External internet request&lt;br&gt;⟷ Bidirectional (read + write)&lt;br&gt;→ Unidirectional&lt;br&gt;&lt;br&gt;Ports public: 80, 443 only"
          style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;rounded=1;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="210" y="855" width="215" height="125" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════
             EDGES — CONNECTIONS
        ═══════════════════════════════════════════════════════════════════ -->

        <!-- 1. Browser → Nginx (HTTPS) -->
        <mxCell id="e1" value="HTTPS :443"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;"
          edge="1" source="browser" target="nginx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Nginx → React SPA (serve static files) -->
        <mxCell id="e2" value="/* (static GET)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;fontSize=10;fontStyle=2;"
          edge="1" source="nginx" target="frontend" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Nginx → FastAPI (proxy /api/*) -->
        <mxCell id="e3" value="proxy /api/*"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;"
          edge="1" source="nginx" target="fastapi" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. FastAPI ↔ PostgreSQL (SQLAlchemy asyncpg) -->
        <mxCell id="e4" value="SQLAlchemy asyncpg&#xa;read / write"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=0;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="fastapi" target="postgres" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. FastAPI → Redis (publish Celery tasks) -->
        <mxCell id="e5" value="publish tasks"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="fastapi" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. FastAPI ↔ Document Storage (upload / download) -->
        <mxCell id="e6" value="upload / download"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=0;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="fastapi" target="storage" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. Worker ↔ Redis (consume tasks / store results) -->
        <mxCell id="e7" value="consume tasks&#xa;/ store results"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=0;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="worker" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. Worker ↔ PostgreSQL (read/write standards, history, notifications) -->
        <mxCell id="e8" value="read/write standards,&#xa;history, notifications"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=0;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="worker" target="postgres" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. Worker ↔ Document Storage -->
        <mxCell id="e9" value="store / read docs"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=0;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="worker" target="storage" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. Beat → Redis (dispatch scheduled tasks) -->
        <mxCell id="e10" value="dispatch tasks"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="beat" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 11. Beat → PostgreSQL (read schedule via DatabaseScheduler, psycopg2 sync) -->
        <mxCell id="e11" value="read schedule&#xa;psycopg2 (sync)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;fontSize=9;fontStyle=2;"
          edge="1" source="beat" target="postgres" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 12. Worker → rss2json.com (RSS poll — dashed = external) -->
        <mxCell id="e12" value="HTTP GET (RSS poll)&#xa;httpx / curl-cffi"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;dashed=1;fontSize=9;fontStyle=2;"
          edge="1" source="worker" target="rss2json" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 13. rss2json.com → ISO.org (fetch RSS) -->
        <mxCell id="e13" value="HTTP GET&#xa;(fetch RSS feeds)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;dashed=1;fontSize=9;fontStyle=2;"
          edge="1" source="rss2json" target="iso" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 14. Worker → SMTP (send email) -->
        <mxCell id="e14" value="STARTTLS :587&#xa;aiosmtplib"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;dashed=1;fontSize=9;fontStyle=2;"
          edge="1" source="worker" target="smtp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 15. Document Storage → AWS S3 (optional, dashed) -->
        <mxCell id="e15" value="boto3 · optional&#xa;(STORAGE_BACKEND=s3)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;dashed=1;fontSize=9;fontStyle=2;"
          edge="1" source="storage" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
