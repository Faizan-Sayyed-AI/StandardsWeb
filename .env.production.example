# ============================================================================
# StandardSphere — PRODUCTION environment template
#
#   cp .env.production.example .env.production     # then fill in the values
#
# Loaded only when APP_ENV=production is set in the process environment.
# Load order (later wins):  defaults -> .env -> .env.production -> real env vars
#
# Place it next to .env in the app's working directory, e.g.
#   /opt/iso-tracker/backend/.env.production
#
# NEVER commit the filled-in .env.production — it is gitignored. Lock it down:
#   chmod 600 .env.production && chown ubuntu:ubuntu .env.production
# ============================================================================


# ── Environment ─────────────────────────────────────────────────────────────
# Must be "production" for the startup safety checks to run. If this is left as
# development, the app will happily boot with the insecure default secrets.
ENVIRONMENT=production

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── Database ────────────────────────────────────────────────────────────────
# Both are required and must point at the same database. The async URL is used
# by the API; the sync URL is used by Celery Beat's scheduler.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/ists
DATABASE_SYNC_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/ists


# ── Redis (Celery broker + result backend) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ── Security — CHANGE BOTH, they have insecure committed defaults ────────────
# The app refuses to start with ENVIRONMENT=production if either is left as its
# default value.

# JWT signing secret.  Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Encrypts api_keys.key_value (the rss2json keys) at rest. Keep it SEPARATE
# from SECRET_KEY — rotating the JWT secret must not strand encrypted keys.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: changing this value makes every already-encrypted API key
# undecryptable ("Could not decrypt secret"). Rotate the stored keys via
# PATCH /api-keys/{id} first, or re-add them afterwards.
API_KEY_ENCRYPTION_KEY=CHANGE_ME

ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1


# ── Document storage ────────────────────────────────────────────────────────
# "local" = files on the server's disk;  "s3" = files in an S3 bucket.
STORAGE_BACKEND=s3

# Only used when STORAGE_BACKEND=local. Keep this OUTSIDE the deploy directory:
# the redeploy procedure moves /opt/iso-tracker/backend aside, which would take
# the uploaded files with it and orphan every documents row.
LOCAL_STORAGE_PATH=/opt/iso-tracker/storage

# Max upload size in MB. There is no reverse proxy in front of uvicorn on this
# deployment, but the ALB's idle timeout (default 60s) still bounds how large an
# upload can realistically be over a slow connection.
MAX_UPLOAD_SIZE_MB=200

# ── S3 (only when STORAGE_BACKEND=s3) ───────────────────────────────────────
# Requires boto3 installed. The bucket should be private with versioning on,
# and needs a CORS rule allowing GET from the frontend origin — the browser
# follows a 307 redirect to a presigned URL, so without CORS downloads fail.
S3_BUCKET_NAME=
AWS_REGION=ap-south-1

# LEAVE BOTH EMPTY to use the EC2 instance's IAM role (recommended — no static
# credentials on disk). boto3 falls back to the instance role automatically.
# Only set them if you must use a dedicated IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ── SMTP ────────────────────────────────────────────────────────────────────
# IMPORTANT: these are only a FALLBACK. Once SMTP has been saved from the admin
# UI (Settings -> SMTP), the values in the system_config database table take
# precedence and everything below is ignored. Check which is in effect with:
#   GET /api/v1/admin/smtp-config
#
# SMTP_USE_TLS means STARTTLS (port 587), NOT implicit TLS (port 465).
# Port 465 is not supported by the current code. AWS blocks outbound port 25.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=ists@example.com


# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Must include the
# CloudFront/S3 domain that serves the UI, or every browser request is blocked.
CORS_ORIGINS=https://your-frontend-domain


# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=60/minute
RATE_LIMIT_DEFAULT=300/minute


# ============================================================================
# NOT configured here — these live in the database, managed via the admin UI
# or API, and are unaffected by this file:
#
#   • rss2json API keys      -> api_keys table (Fernet-encrypted)
#                               POST/PATCH /api/v1/api-keys
#   • AI document tagging     -> system_config table
#     (service URL + API key)   PATCH /api/v1/admin/document-tagging-config
#   • SMTP settings           -> system_config table (overrides the block above)
#                               PATCH /api/v1/admin/smtp-config
# ============================================================================
