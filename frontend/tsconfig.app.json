{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting — relaxed for active feature development */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Test files are excluded from the app's `tsc -b` typecheck: they rely on
  // vitest globals (describe/test/expect) that are not in `types` above, so
  // including them here would fail the production build. They still run under
  // vitest (`npm run test`), which transpiles via esbuild without type-checking.
  // Trade-off: type errors inside *.test.ts(x) are not caught at build time.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
